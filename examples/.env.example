# Required for live mode (`bash benchmark.sh --mode live`, `jeval run --mode live`). Never commit the real key.
TYPESAFE_API_KEY=
# Optional overrides
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Vercel AI Gateway (used for the recorded runs): put the AI Gateway API key in TYPESAFE_API_KEY and uncomment:
# TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
# TYPESAFE_DEFAULT_MODEL=typesafe-ai/jev
