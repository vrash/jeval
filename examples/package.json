{
  "name": "jeval-examples",
  "private": true,
  "type": "module",
  "description": "Example datasets, fixtures and scripts for jeval (synthetic, provisional labels)",
  "scripts": {
    "sdk": "tsx sdk-example.ts",
    "cli": "jeval run --mode fixture --config jeval.config.json --html",
    "cli:holdout": "jeval run --mode fixture --config jeval.holdout.config.json --html",
    "benchmark": "bash benchmark.sh",
    "labels": "node scripts/extract-labels.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@jeval/cli": "workspace:*",
    "@jeval/core": "workspace:*",
    "@jeval/provider-jev": "workspace:*",
    "@types/node": "26.6.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
