{
  "name": "@jeval/cli",
  "version": "0.1.0",
  "description": "jeval command line: init, run, report, compare and benchmark evaluations",
  "license": "MIT",
  "type": "module",
  "bin": { "jeval": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@jeval/core": "workspace:*",
    "@jeval/provider-jev": "workspace:*",
    "commander": "15.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "keywords": ["jeval", "evaluation", "cli"],
  "publishConfig": { "access": "public" }
}
