# Root example. The CLI reads .env from the directory containing jeval.config.json.
# Required only for live runs; fixture runs need nothing.
TYPESAFE_API_KEY=
# Optional
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Opt-in live smoke test: JEVAL_LIVE=1 pnpm test:live
