# --- Site ---
# Canonical public URL. Used for metadata, sitemap and the Origin allowlist of the waitlist endpoint.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public repository URL. Leave empty until the repository is actually public; the site hides the link when unset.
NEXT_PUBLIC_REPO_URL=

# --- Waitlist (server only; never expose the service role key to the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random secret used to hash rate-limit keys so raw IP addresses are never stored.
WAITLIST_RATE_LIMIT_SECRET=
# Comma-separated extra origins allowed to POST to the waitlist (preview URLs etc.). NEXT_PUBLIC_SITE_URL is always allowed.
WAITLIST_ALLOWED_ORIGINS=

# --- Optional live demo (server only). Leave unset to keep the public demo on simulated fixtures. ---
TYPESAFE_API_KEY=
DEMO_LIVE_ENABLED=false
DEMO_MODEL=jev-latest
# Hard ceiling on live demo requests per UTC day across all instances. Requires the Supabase tables.
DEMO_DAILY_REQUEST_CEILING=200
